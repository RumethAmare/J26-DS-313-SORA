  "utterances": [
    {
      "utt_id": "J26DS313_R0005_w001",
      "start": 2.1,
      "end": 5.6,
      "text": "පිරිපික්පි කිරීම් ගනමත් අතුදු."
    },
    {
      "utt_id": "J26DS313_R0005_w002",
      "start": 6.6,
      "end": 10.6,
      "text": "එය සාකයක් පාන්නන්දාලිශ් මෝගත් කරාණයක්පාවන් දියිසම් ඉතිසර්."
    },
    {
      "utt_id": "J26DS313_R0005_w003",
      "start": 11.6,
      "end": 16.1,
      "text": "අතුරිටි පාන්න්ඩ්දාලිශ් ඉතිසර්පය."
    },
    {
      "utt_id": "J26DS313_R0005_w004",
      "start": 16.1,
      "end": 19.1,
      "text": "හා හා ැමේ හා හා ශහා සිස්වක් හා සරස් විශ්‍ඏ."
    },
    {
      "utt_id": "J26DS313_R0005_w005",
      "start": 19.1,
      "end": 22.1,
      "text": "හා සැගවියිගව්ම් වයක් හැඹික්‍ව‍ඩිඅිියි හැයිඟු,"
    },
    {
      "utt_id": "J26DS313_R0005_w006",
      "start": 22.1,
      "end": 29.16,
      "text": "ඔබ රැ කෙසිදි අතුක ක රැ කිහම කිසය අටික කිහම ක්රීම් ලිරිය."
    },
    {
      "utt_id": "J26DS313_R0005_w007",
      "start": 29.66,
      "end": 36.16,
      "text": "ඔබ කිරීම් එකතු අැතික් කිසිදි අමුල් කිරීම් අමුල් කිසිදි."
    },
    {
      "utt_id": "J26DS313_R0005_w008",
      "start": 36.16,
      "end": 49.54,
      "text": "ඔමු මින් ඇතන් සම් ඇතන් නහැන් හාවික් පසුල් අත් සක අපි"
    }
  ]
}