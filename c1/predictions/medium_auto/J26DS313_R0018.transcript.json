  "utterances": [
    {
      "utt_id": "J26DS313_R0018_w001",
      "start": 1.39,
      "end": 5.03,
      "text": "හැලිතක මිශ්‍රිල් ඬෙන් කරන්දමයි බැරත් මිශ්‍රිල් හැලිත මිශ්‍රිල් දිය පහොඳින් කරන්න දටමික් බැළෆ හැලිතක් පවිටනි රිත්"
    },
    {
      "utt_id": "J26DS313_R0018_w002",
      "start": 5.03,
      "end": 8.03,
      "text": "මම මේ්ර අපි රැපි හා තියන්ණය."
    },
    {
      "utt_id": "J26DS313_R0018_w003",
      "start": 8.03,
      "end": 12.03,
      "text": "අපි භාමගතියටල්වක් දිය කරන්ල්ණය."
    },
    {
      "utt_id": "J26DS313_R0018_w004",
      "start": 12.03,
      "end": 16.03,
      "text": "මේ්ර අපි ඇත්යි දියි කරන්ණයේ්ණය."
    },
    {
      "utt_id": "J26DS313_R0018_w005",
      "start": 16.03,
      "end": 18.03,
      "text": "ස් කැල්ඤා කරන්ඩිය."
    },
    {
      "utt_id": "J26DS313_R0018_w006",
      "start": 18.03,
      "end": 20.57,
      "text": "ප්ං,ණාඩ් එක එය ගන්සි."
    },
    {
      "utt_id": "J26DS313_R0018_w007",
      "start": 21.77,
      "end": 24.61,
      "text": "මම හාස ගටාමි."
    },
    {
      "utt_id": "J26DS313_R0018_w008",
      "start": 32.23,
      "end": 38.87,
      "text": "අවය හොඳාණාඩෛ ප්ංού� Wishy 38."
    },
    {
      "utt_id": "J26DS313_R0018_w009",
      "start": 39.21,
      "end": 43.63,
      "text": "වඨියකතු ප්ංමින ආය වැනයකෝරහ කළලි."
    },
    {
      "utt_id": "J26DS313_R0018_w010",
      "start": 44.27,
      "end": 47.11,
      "text": "බෙමි සූඣුෂරෙරු�只 සාව ඔරු."
    },
    {
      "utt_id": "J26DS313_R0018_w011",
      "start": 47.11,
      "end": 52.93,
      "text": "අයින්ට පියමියකියක් අයිනියකියක්වයක් ඇතිය ඔබට ඉතියිස්පයකත් මැලිදමය."
    },
    {
      "utt_id": "J26DS313_R0018_w012",
      "start": 55.95,
      "end": 59.59,
      "text": "අයින්ට අයිනියක් අයිනියක් අමත් ලදන්න එයලම න්ටර දියම්ර."
    },
    {
      "utt_id": "J26DS313_R0018_w013",
      "start": 59.59,
      "end": 65.06,
      "text": "మానా విమిన పరానిన Teddy నిప్తాగానినని ఉపి జిల్ను స్రామను ఉపిలిను ఉపిల.."
    },
    {
      "utt_id": "J26DS313_R0018_w014",
      "start": 65.06,
      "end": 68.02,
      "text": "అసిత్తాందికందాను!"
    },
    {
      "utt_id": "J26DS313_R0018_w015",
      "start": 68.02,
      "end": 70.32,
      "text": "රහිළිසරජෙකීම්!"
    },
    {
      "utt_id": "J26DS313_R0018_w016",
      "start": 70.32,
      "end": 70.98,
      "text": "මිහෙවීමුට ණිහියට්ස්ඥදකර end."
    },
    {
      "utt_id": "J26DS313_R0018_w017",
      "start": 72.78,
      "end": 75.5,
      "text": "නුලුන්, අමෝසෙළව් පෙණිහැරි පාරියකඩිස්ස්ස්ස පිසියි"
    },
    {
      "utt_id": "J26DS313_R0018_w018",
      "start": 75.5,
      "end": 80.74,
      "text": "වෙර බෝයන් මුඹුල, අපි සාදීමියිට්."
    },
    {
      "utt_id": "J26DS313_R0018_w019",
      "start": 80.74,
      "end": 87.84,
      "text": "මත අපි කිරහිකක්රික්රිසකප නහික අපි ගබාන්න් කෝ අපි පිහිහික්රිසක්"
    },
    {
      "utt_id": "J26DS313_R0018_w020",
      "start": 117.84,
      "end": 121.2,
      "text": "කෝ්ලයින්න් නිශ්පා?"
    },
    {
      "utt_id": "J26DS313_R0018_w021",
      "start": 121.2,
      "end": 127.68,
      "text": "කෑරින් කිරියිමේ කිරිසම කෙන්, 33 ක්සාරුබෙම්,ඩියන්න්යල් හැඹියිම් ලෙස්නම්."
    },
    {
      "utt_id": "J26DS313_R0018_w022",
      "start": 127.68,
      "end": 129.68,
      "text": "හාසලුවෟෙපාප්‬"
    },
    {
      "utt_id": "J26DS313_R0018_w023",
      "start": 129.9,
      "end": 131.9,
      "text": "වෙලුවූින්‬"
    },
    {
      "utt_id": "J26DS313_R0018_w024",
      "start": 132.52,
      "end": 134.52,
      "text": "හැටින්‬"
    },
    {
      "utt_id": "J26DS313_R0018_w025",
      "start": 134.52,
      "end": 137.0,
      "text": "හැටින්‬"
    },
    {
      "utt_id": "J26DS313_R0018_w026",
      "start": 137.0,
      "end": 138.32,
      "text": "හැටින්‬"
    },
    {
      "utt_id": "J26DS313_R0018_w027",
      "start": 138.32,
      "end": 140.0,
      "text": "වළිකුෂ්‬"
    },
    {
      "utt_id": "J26DS313_R0018_w028",
      "start": 140.0,
      "end": 140.96,
      "text": "පෙල්වාැරියි"
    },
    {
      "utt_id": "J26DS313_R0018_w029",
      "start": 141.26,
      "end": 143.26,
      "text": "වැටින්‬"
    },
    {
      "utt_id": "J26DS313_R0018_w030",
      "start": 143.46,
      "end": 145.46,
      "text": "අළවු්සුතියික්‬"
    },
    {
      "utt_id": "J26DS313_R0018_w031",
      "start": 145.94,
      "end": 147.94,
      "text": "ෂහියිින්‬"
    },
    {
      "utt_id": "J26DS313_R0018_w032",
      "start": 147.94,
      "end": 155.88,
      "text": "ස්රියියි ස්රියි."
    }
  ]
}