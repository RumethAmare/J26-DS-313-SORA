      "start": 5.12,
      "end": 7.0,
      "text": "Who's the connection?"
    },
    {
      "utt_id": "J26DS313_R0017_w004",
      "start": 8.32,
      "end": 10.48,
      "text": "Good morning, I'm Alut Gidra."
    },
    {
      "utt_id": "J26DS313_R0017_w005",
      "start": 10.48,
      "end": 13.36,
      "text": "How do you get the electricity connection?"
