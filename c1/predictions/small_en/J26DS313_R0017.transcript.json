      "utt_id": "J26DS313_R0017_w027",
      "start": 86.88,
      "end": 91.48,
      "text": "I'm checking for the nearest transformer."
    },
    {
      "utt_id": "J26DS313_R0017_w028",
      "start": 91.48,
      "end": 93.44,
      "text": "Do you check the load capacity for the transformer?"
    },
    {
      "utt_id": "J26DS313_R0017_w029",
      "start": 93.44,
      "end": 99.6,
      "text": "Sir, there's a 70% load capacity for the transformer in this area."
