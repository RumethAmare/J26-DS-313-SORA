    {
      "utt_id": "J26DS313_R0017_w022",
      "start": 66.64,
      "end": 71.48,
      "text": "I'm using Single-Face for the first time in my life."
    },
    {
      "utt_id": "J26DS313_R0017_w023",
      "start": 71.48,
      "end": 74.28,
      "text": "What's the technical assessment?"
    },
    {
      "utt_id": "J26DS313_R0017_w024",
      "start": 74.88,
      "end": 81.4,
      "text": "Sir, I got 89 new candy rods for the new connection."
    },
    {
      "utt_id": "J26DS313_R0017_w025",
      "start": 81.4,
      "end": 84.28,
      "text": "Yes, I'm a technical officer Mahesh."
    },
    {
      "utt_id": "J26DS313_R0017_w026",
      "start": 84.28,
      "end": 86.88,
      "text": "I'm doing my site visit."
    },
