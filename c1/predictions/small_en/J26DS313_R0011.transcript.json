      "utt_id": "J26DS313_R0011_w001",
      "start": 0.62,
      "end": 5.62,
      "text": "Good morning, Langka Broadband here with us, Nethmi speaking, how are you?"
    },
    {
      "utt_id": "J26DS313_R0011_w002",
      "start": 5.62,
      "end": 6.62,
      "text": "Hello, Nethmi."
    },
    {
      "utt_id": "J26DS313_R0011_w003",
      "start": 6.62,
      "end": 8.62,
      "text": "My internet connection is not working."
    },
    {
      "utt_id": "J26DS313_R0011_w004",
      "start": 8.62,
      "end": 11.62,
      "text": "I have to restart the router to get the signal."
    },
    {
      "utt_id": "J26DS313_R0011_w005",
      "start": 11.62,
      "end": 14.62,
      "text": "I apologize for the inconvenience."
    },
    {
      "utt_id": "J26DS313_R0011_w006",
      "start": 14.62,
      "end": 16.62,
      "text": "I have to check the system."
    },
    {
      "utt_id": "J26DS313_R0011_w007",
      "start": 16.62,
      "end": 17.62,
      "text": "What is your name?"
    },
    {
      "utt_id": "J26DS313_R0011_w008",
      "start": 17.62,
      "end": 27.62,
      "text": "My name is Roshan Pereira."
    },
    {
      "utt_id": "J26DS313_R0011_w009",
      "start": 27.62,
      "end": 28.62,
      "text": "Thank you Roshan."
    },
    {
      "utt_id": "J26DS313_R0011_w010",
      "start": 28.62,
      "end": 33.62,
      "text": "Roshan, address is 10, number 10, Flower Road, Colombo 7."
    },
    {
      "utt_id": "J26DS313_R0011_w011",
      "start": 33.62,
      "end": 34.62,
      "text": "Yes, that's right."
    },
    {
      "utt_id": "J26DS313_R0011_w012",
      "start": 34.62,
      "end": 36.62,
      "text": "I have been waiting for you to come."
    },
    {
      "utt_id": "J26DS313_R0011_w013",
      "start": 36.62,
      "end": 38.62,
      "text": "So, this is a problem."
    },
    {
      "utt_id": "J26DS313_R0011_w014",
      "start": 38.62,
      "end": 40.62,
      "text": "You can't do this in a month."
    },
    {
      "utt_id": "J26DS313_R0011_w015",
      "start": 40.62,
      "end": 41.62,
      "text": "Okay, sir."
    },
    {
      "utt_id": "J26DS313_R0011_w016",
      "start": 41.62,
      "end": 43.62,
      "text": "I have to connect to the technical team."
    },
    {
      "utt_id": "J26DS313_R0011_w017",
      "start": 43.62,
      "end": 44.62,
      "text": "I have to go to Podda line."
    },
    {
      "utt_id": "J26DS313_R0011_w018",
      "start": 44.62,
      "end": 46.62,
      "text": "I have to go to Faheem and Atme line."
    },
    {
      "utt_id": "J26DS313_R0011_w019",
      "start": 46.62,
      "end": 47.62,
      "text": "What is your problem?"
    },
    {
      "utt_id": "J26DS313_R0011_w020",
      "start": 47.62,
      "end": 48.62,
      "text": "Yes, Nethmi."
    },
    {
      "utt_id": "J26DS313_R0011_w021",
      "start": 48.62,
      "end": 50.62,
      "text": "This is a problem."
    },
    {
      "utt_id": "J26DS313_R0011_w022",
      "start": 50.62,
      "end": 55.62,
      "text": "I have to reset the router to get the signal."
    },
    {
      "utt_id": "J26DS313_R0011_w023",
      "start": 55.62,
      "end": 59.62,
      "text": "We can reset the router in the back end."
    },
    {
      "utt_id": "J26DS313_R0011_w024",
      "start": 59.62,
      "end": 61.62,
      "text": "You can reset it in the back end, right?"
    },
    {
      "utt_id": "J26DS313_R0011_w025",
      "start": 61.62,
      "end": 63.62,
      "text": "I have to reset it in the back end."
    },
    {
      "utt_id": "J26DS313_R0011_w026",
      "start": 63.62,
      "end": 65.62,
      "text": "It can be damaged."
    },
    {
      "utt_id": "J26DS313_R0011_w027",
      "start": 65.62,
      "end": 67.62,
      "text": "Yes, it can be damaged."
    },
    {
      "utt_id": "J26DS313_R0011_w028",
      "start": 67.62,
      "end": 70.62,
      "text": "We have to do a physical inspection."
    },
    {
      "utt_id": "J26DS313_R0011_w029",
      "start": 70.62,
      "end": 74.62,
      "text": "It's not necessary to do the inspection in the back end."
    },
    {
      "utt_id": "J26DS313_R0011_w030",
      "start": 74.62,
      "end": 76.62,
      "text": "We will try."
    },
    {
      "utt_id": "J26DS313_R0011_w031",
      "start": 76.62,
      "end": 80.62,
      "text": "Can you confirm the name of Roshan and his mobile number?"
    },
    {
      "utt_id": "J26DS313_R0011_w032",
      "start": 80.62,
      "end": 84.62,
      "text": "What is the technician's call?"
    },
    {
      "utt_id": "J26DS313_R0011_w033",
      "start": 84.62,
      "end": 86.62,
      "text": "His name is Bindu."
    },
    {
      "utt_id": "J26DS313_R0011_w034",
      "start": 86.62,
      "end": 89.62,
      "text": "You can check his number and his address."
    },
    {
      "utt_id": "J26DS313_R0011_w035",
      "start": 89.62,
      "end": 92.62,
      "text": "We have to tell him to come to the team."
    },
    {
      "utt_id": "J26DS313_R0011_w036",
      "start": 92.62,
      "end": 94.62,
      "text": "Okay, sir."
    },
    {
      "utt_id": "J26DS313_R0011_w037",
      "start": 94.62,
      "end": 95.62,
      "text": "Please update me."
