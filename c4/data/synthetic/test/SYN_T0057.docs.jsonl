{"doc_id": "SYN_T0057_transcript_u003_v1", "recording": "SYN_T0057", "kind": "transcript", "utterance": 3, "topic": "name", "text": "Shanika Abeysekara thamai."}
{"doc_id": "SYN_T0057_c2_u003_en_v1", "recording": "SYN_T0057", "kind": "en", "utterance": 3, "topic": "name", "text": "It is Shanika Abeysekara."}
{"doc_id": "SYN_T0057_c2_u003_si_v1", "recording": "SYN_T0057", "kind": "si", "utterance": 3, "topic": "name", "text": "ශානිකා අබේසේකර."}
